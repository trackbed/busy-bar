# Copy to .env.local (gitignored). Nx loads it into every task, so apps in both
# languages read these values. See docs/busy-bar.md#connecting.

# IP address, host name, or URL of the bar. Leave unset for a bar plugged in
# over USB (10.0.4.20). Use https://api.busy.app for the cloud proxy.
BUSYBAR_ADDR=

# Wi-Fi: the bar's HTTP access password, if one is set.
# Cloud: an API token from https://cloud.busy.app/api-tokens (required).
BUSYBAR_TOKEN=

# apps/clock: IANA time zone such as Europe/Copenhagen. Defaults to the system's.
CLOCK_TIME_ZONE=

# apps/countdown: ISO 8601 date and time with a UTC offset, and an ASCII label.
COUNTDOWN_TARGET=2026-12-24T18:00:00+01:00
COUNTDOWN_LABEL=XMAS

# apps/agent-fleet: where Claude Code's hooks post (see its README), and alerts.
AGENT_FLEET_HOST=
AGENT_FLEET_PORT=
AGENT_FLEET_SOUND=
AGENT_FLEET_QUIET_MINUTES=

# apps/claude-limits: conductor-claude-rotation's data root, and alerts.
CLAUDE_LIMITS_DIR=
CLAUDE_LIMITS_SOUND=

# apps/copenhagen-glance: DK1 or DK2, where to forecast rain, and whether to.
GLANCE_PRICE_AREA=
GLANCE_LATITUDE=
GLANCE_LONGITUDE=
GLANCE_RAIN=

# apps/event-day: PhotoCraft booths (event-slug/booth-slug, comma separated)
# and/or a ChallengeCraft TV leaderboard. No priority shows over a BUSY timer.
EVENT_DAY_PHOTOCRAFT_URL=
EVENT_DAY_BOOTHS=
EVENT_DAY_QUIET_MINUTES=
EVENT_DAY_CHALLENGE_URL=
EVENT_DAY_CHALLENGE_TOKEN=
EVENT_DAY_PRIORITY=
EVENT_DAY_SOUND=

# apps/intercom: the team's Convex deployment (https://<name>.convex.cloud),
# this bar's key from bars:add (secret: keep it in .env.local), chimes, and
# the minutes of a team focus this bar starts.
INTERCOM_CONVEX_URL=
INTERCOM_KEY=
INTERCOM_SOUND=
INTERCOM_FOCUS_MINUTES=

# apps/linear-queue: a personal API key (secret: keep it in .env.local) and
# the team, ready label, assignee (me), and low-water mark.
LINEAR_API_KEY=
LINEAR_QUEUE_TEAM=
LINEAR_QUEUE_LABEL=
LINEAR_QUEUE_ASSIGNEE=
LINEAR_QUEUE_LOW=

# apps/merge-ticker: a GitHub token (secret: keep it in .env.local, or use
# GITHUB_TOKEN=$(gh auth token)), extra search qualifiers, time zone, alerts.
GITHUB_TOKEN=
MERGE_TICKER_SCOPE=
MERGE_TICKER_TIME_ZONE=
MERGE_TICKER_SOUND=
