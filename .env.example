# Copy to .env.local (gitignored). Nx loads it into every task, so apps in both
# languages read these values. See docs/busy-bar.md#connecting.

# IP address, host name, or URL of the bar. Leave unset for a bar plugged in
# over USB (10.0.4.20). Use https://api.busy.app for the cloud proxy.
BUSYBAR_ADDR=

# Wi-Fi: the bar's HTTP access password, if one is set.
# Cloud: an API token from https://cloud.busy.app/api-tokens (required).
BUSYBAR_TOKEN=

# apps/clock: IANA time zone such as Europe/Copenhagen. Defaults to the system's.
CLOCK_TIME_ZONE=

# apps/countdown: ISO 8601 date and time with a UTC offset, and an ASCII label.
COUNTDOWN_TARGET=2026-12-24T18:00:00+01:00
COUNTDOWN_LABEL=XMAS

# apps/agent-fleet: where Claude Code's hooks post (see its README), and alerts.
AGENT_FLEET_HOST=
AGENT_FLEET_PORT=
AGENT_FLEET_SOUND=
AGENT_FLEET_QUIET_MINUTES=
