{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/spec",
    "tsBuildInfoFile": "dist/spec/tsconfig.spec.tsbuildinfo",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/__tests__/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/web/**"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
