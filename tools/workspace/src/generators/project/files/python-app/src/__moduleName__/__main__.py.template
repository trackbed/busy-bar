"""Run the app: `nx run <%= name %>:start` or `python -m <%= moduleName %>`."""

import asyncio
import logging

from bar_kit import (
    create_busy_bar,
    install_shutdown_handlers,
    load_bar_config,
    run_bar_app,
)
from <%= moduleName %>.render import render


async def main() -> None:
    stop = asyncio.Event()
    install_shutdown_handlers(stop)
    client = create_busy_bar(load_bar_config())
    # busylib types `__aenter__` as returning its base client, so keep this
    # reference instead of binding the context manager's result.
    async with client:
        await run_bar_app(
            name="<%= name %>", client=client, render=render, interval=1.0, stop=stop
        )


if __name__ == "__main__":
    logging.basicConfig(level=logging.WARNING)
    asyncio.run(main())
