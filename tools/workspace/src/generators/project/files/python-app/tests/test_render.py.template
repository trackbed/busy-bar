from datetime import UTC, datetime

from bar_kit import FRONT_DISPLAY, DisplayName, TextElement, fit_text
from <%= moduleName %>.render import render


def test_draws_the_title_on_the_front_display() -> None:
    (element,) = render(datetime(2026, 1, 1, tzinfo=UTC))

    assert isinstance(element, TextElement)
    assert element.text == fit_text("<%= title %>", "normal", FRONT_DISPLAY.width)
    assert element.display == DisplayName.FRONT
