from datetime import UTC, datetime

from busylib import types

from <%= moduleName %>.render import render


def test_draws_the_title_on_the_front_display() -> None:
    (element,) = render(datetime(2026, 1, 1, tzinfo=UTC))

    assert isinstance(element, types.TextElement)
    assert element.text == "<%= title %>"
    assert element.display == types.DisplayName.FRONT
