[project]
name = "<%= name %>"
version = "0.0.1"
description = "A BUSY Bar app."
requires-python = ">=3.14"
dependencies = ["bar-kit"]

[tool.uv.sources]
bar-kit = { workspace = true }

[build-system]
requires = ["uv_build>=0.11.23,<0.14"]
build-backend = "uv_build"

[tool.coverage.run]
branch = true
source = ["src"]
# The process entry points only wire the kit together (__main__.py) or print
# sample frames (preview.py); render.py holds the behavior.
omit = [
  "src/<%= moduleName %>/__main__.py",
  "src/<%= moduleName %>/preview.py",
]

[tool.coverage.report]
# Ratchet upward; never lower it to make a change pass.
fail_under = 95
show_missing = true
