{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortImports": {
    "groups": [
      "builtin",
      { "newlinesBetween": false },
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "unknown"
    ],
    "internalPattern": ["@busy-bar-apps/"]
  },
  "sortPackageJson": {},
  "ignorePatterns": [
    "/.context",
    "/.nx",
    "/.venv",
    "**/convex/_generated",
    "**/coverage",
    "**/dist",
    "uv.lock",
    "yarn.lock"
  ]
}
