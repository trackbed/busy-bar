{
  "name": "@busy-bar-apps/source",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "bootstrap:status": "node scripts/check-workspace-ready.mjs",
    "format:check": "oxfmt --check . && uv run ruff format --check .",
    "format:write": "oxfmt . && uv run ruff format .",
    "hooks:install": "node scripts/setup-hooks.mjs",
    "hooks:policy:pre-commit": "sh scripts/pre-commit-policy.sh",
    "lint:all": "NX_DAEMON=${NX_DAEMON:-false} nx run-many -t lint --outputStyle=static",
    "postinstall": "node scripts/setup-hooks.mjs",
    "test:all": "NX_DAEMON=${NX_DAEMON:-false} nx run-many -t test --outputStyle=static",
    "typecheck:all": "NX_DAEMON=${NX_DAEMON:-false} nx run-many -t typecheck --outputStyle=static",
    "verify": "bash scripts/verify.sh",
    "verify:fast": "bash scripts/verify.sh --fast"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@nx/devkit": "24.0.5",
    "@nx/eslint": "24.0.5",
    "@nx/eslint-plugin": "24.0.5",
    "@nx/js": "24.0.5",
    "@nx/oxlint": "24.0.5",
    "@nx/vitest": "24.0.5",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-oxlint": "1.93.0",
    "happy-dom": "20.11.2",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "nx": "24.0.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "resolutions": {
    "undici@npm:7.29.0": "npm:7.29.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.18.1",
  "nx": {
    "includedScripts": []
  }
}
